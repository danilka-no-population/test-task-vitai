# Turso (libsql) — SQLite по HTTP. Скопируйте в .env.local реальные значения.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# Telegram-бот (опционально) — дублирование заявок менеджеру
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Публичный URL сайта для OG-превью (опционально)
NEXT_PUBLIC_SITE_URL=
